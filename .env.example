# --- База данных (SQLite) ---
DATABASE_URL=file:./db/custom.db

# --- ИИ по умолчанию (используется, если в настройках выбран «Встроенный ИИ» или свой сервер недоступен) ---
# Любой OpenAI-совместимый сервер: Groq, OpenRouter, Ollama, LM Studio, vLLM...
# Пример для Groq:  https://api.groq.com/openai/v1  +  ключ с console.groq.com/keys  +  llama-3.3-70b-versatile
# Пример для Ollama: http://localhost:11434/v1  (ключ не нужен)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Таймауты в миллисекундах (необязательно; значения по умолчанию подходят большинству)
# LLM_TIMEOUT_MS=240000               # целый нестриминговый ответ (глубокий анализ)
# LLM_FIRST_TOKEN_TIMEOUT_MS=90000    # ожидание первого токена (модель может загружаться в память)
# LLM_STREAM_IDLE_TIMEOUT_MS=45000    # максимальная пауза внутри идущего ответа

# --- Веб-поиск вакансий (нужен хотя бы один) ---
# 1) Свой SearXNG (в его settings.yml должен быть включён формат json):
#    docker run -d -p 8080:8080 -v ./searxng:/etc/searxng searxng/searxng
SEARXNG_URL=
# 2) Или Brave Search API (бесплатный тариф: https://brave.com/search/api/)
BRAVE_API_KEY=

# --- Безопасность ---
# API отвечает только на localhost / 127.0.0.1. Если открываешь приложение с другого адреса —
# перечисли хосты через запятую (без порта), например: ALLOWED_HOSTS=my-pc.local
ALLOWED_HOSTS=

# --- Кеш поиска ---
# Результаты веб-поиска, Arbeitsagentur и разбор ИИ хранятся в db/cache: повторный поиск быстрее, дешевле и даёт те же
# результаты. SEARCH_CACHE_HOURS=0 отключает кеш (каждый поиск идёт заново); папку можно удалять в любой момент.
# SEARCH_CACHE_HOURS=6
# CACHE_DIR=db/cache
